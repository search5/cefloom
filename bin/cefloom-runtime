#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * Installs the CEF runtime (libcef.so, its resources, cefloomsubprocess) that the cefloom extension loads.
 *
 *   php bin/cefloom-runtime install --base-url=https://.../releases/download/0.1.0
 *   php bin/cefloom-runtime install --url=/path/or/https-url/cefloom-runtime-154.0.34-linux-x86_64.tar.gz --sha256=<hex>
 *   php bin/cefloom-runtime status
 *   php bin/cefloom-runtime path
 *
 * The runtime goes to Cefloom\Cef::userRuntimeDirectory() ($XDG_DATA_HOME or ~/.local/share, then cefloom/runtime/<major.minor.patch>),
 * unless --dir is given. The archive's manifest (cefloom-runtime.json) has to name the CEF version of the module
 * (Cef::cefVersion()); install refuses another one.
 *
 * Needs the extension cefloom; `install` also needs zlib and phar. Needs no Composer.
 *
 * Exit status: 0 on success (also for no command or `help`, which print the usage, and for a non-CLI SAPI), 1 on failure or
 * when `status` finds no runtime, 2 for an unknown command.
 */

use Cefloom\Cef;

if (PHP_SAPI !== 'cli') {
    exit("cefloom-runtime runs on the command line only\n");
}
if (!extension_loaded('cefloom')) {
    fwrite(STDERR, "The cefloom extension is not loaded. Install it (pie install) or run: php -d extension=/path/to/cefloom.so " . $argv[0] . "\n");
    exit(1);
}

foreach (['phar', 'zlib'] as $needed) {
    if (!extension_loaded($needed) && ($argv[1] ?? '') === 'install') {
        fwrite(STDERR, "cefloom-runtime: the PHP extension $needed is needed to unpack the runtime and is not loaded\n");
        exit(1);
    }
}

/** Print "cefloom-runtime: $message" on stderr and exit with status 1. */
function fail(string $message): never
{
    fwrite(STDERR, "cefloom-runtime: $message\n");
    exit(1);
}

/**
 * Parse `--name=value` and `--flag` arguments; any other argument is fatal.
 *
 * @param string[] $args Arguments after the command name.
 * @return array{flags: array<string, true>, values: array<string, string>}
 */
function options(array $args): array
{
    $result = ['flags' => [], 'values' => []];
    foreach ($args as $arg) {
        if (preg_match('/^--([a-z0-9-]+)=(.*)$/s', $arg, $m)) {
            $result['values'][$m[1]] = $m[2];
        } elseif (str_starts_with($arg, '--')) {
            $result['flags'][substr($arg, 2)] = true;
        } else {
            fail("unexpected argument: $arg");
        }
    }
    return $result;
}

/** Return the architecture part of the archive name, "x86_64" or "arm64"; fatal on any other machine. */
function architecture(): string
{
    return match (php_uname('m')) {
        'x86_64', 'amd64' => 'x86_64',
        'aarch64', 'arm64' => 'arm64',
        default => fail('unsupported architecture: ' . php_uname('m')),
    };
}

/**
 * Copy a file from an https URL, an http URL or a path (also file://) to $to.
 *
 * @param bool $progress Print the megabytes copied on stderr every 16 MB.
 * @return int The number of bytes copied; fatal if the source cannot be read.
 */
function fetch(string $source, string $to, bool $progress): int
{
    if (str_starts_with($source, 'file://')) {
        $source = substr($source, 7);
    }
    $context = stream_context_create(['http' => ['timeout' => 60, 'follow_location' => 1, 'user_agent' => 'cefloom-runtime']]);
    $in = @fopen($source, 'rb', false, $context);
    if ($in === false) {
        fail("cannot open $source");
    }
    $out = fopen($to, 'wb');
    $total = 0;
    $next = 16 << 20;
    while (!feof($in)) {
        $chunk = fread($in, 1 << 20);
        if ($chunk === false) {
            fail("reading $source failed");
        }
        fwrite($out, $chunk);
        $total += strlen($chunk);
        if ($progress && $total >= $next) {
            fwrite(STDERR, sprintf("  %d MB\r", $total >> 20));
            $next += 16 << 20;
        }
    }
    fclose($in);
    fclose($out);
    return $total;
}

/** Delete $path recursively; symbolic links are removed, not followed. A missing path is ignored. */
function remove_tree(string $path): void
{
    if (!file_exists($path) && !is_link($path)) {
        return;
    }
    if (is_dir($path) && !is_link($path)) {
        foreach (scandir($path) as $entry) {
            if ($entry !== '.' && $entry !== '..') {
                remove_tree($path . '/' . $entry);
            }
        }
        rmdir($path);
    } else {
        unlink($path);
    }
}

/** Print the CEF version of the module, Cef::runtimeDirectory(), Cef::userRuntimeDirectory(), whether libcef.so is readable in the runtime directory, and the CEF version of its manifest if there is one. Returns 0 if libcef.so is readable, else 1. */
function status(): int
{
    $dir = Cef::runtimeDirectory();
    $has = is_readable($dir . '/libcef.so');
    echo "CEF version of the module: ", Cef::cefVersion(), "\n";
    echo "runtime directory:         $dir\n";
    echo "install directory:         ", Cef::userRuntimeDirectory(), "\n";
    echo "runtime present:           ", $has ? 'yes' : 'no', "\n";
    $manifest = $dir . '/cefloom-runtime.json';
    if ($has && is_readable($manifest)) {
        $data = json_decode((string) file_get_contents($manifest), true);
        echo "runtime CEF version:       ", $data['cef'] ?? 'unknown', "\n";
    }
    return $has ? 0 : 1;
}

/**
 * Download, verify and unpack the runtime into the install directory.
 *
 * Checks the SHA-256 of the archive and that its manifest names the CEF version of the module, and installs
 * through a temporary directory beside the target (<dir>.tmp-<pid>).
 *
 * The archive comes from --url, else $CEFLOOM_RUNTIME_URL, else --base-url (or $CEFLOOM_RUNTIME_BASE_URL) plus the archive name; the checksum from
 * --sha256, else the first 64 characters of <archive URL>.sha256. A runtime already in the directory (libcef.so readable) is kept unless --force is given.
 *
 * @param array{flags: array<string, true>, values: array<string, string>} $o Parsed options: url, base-url, sha256, dir, force.
 * @return int 0 on success and when a runtime is already installed; every failure exits with status 1 inside fail().
 */
function install(array $o): int
{
    $cef = Cef::cefVersion();
    $short = explode('+', $cef)[0];
    $name = "cefloom-runtime-$short-linux-" . architecture() . '.tar.gz';

    $url = $o['values']['url'] ?? getenv('CEFLOOM_RUNTIME_URL') ?: null;
    if ($url === null) {
        $base = $o['values']['base-url'] ?? getenv('CEFLOOM_RUNTIME_BASE_URL') ?: null;
        if ($base === null) {
            fail("say where the runtime is: --url=<archive> or --base-url=<directory of the release files> (the archive is called $name)");
        }
        $url = rtrim($base, '/') . '/' . $name;
    }
    $dir = $o['values']['dir'] ?? Cef::userRuntimeDirectory();
    if (is_readable($dir . '/libcef.so') && !isset($o['flags']['force'])) {
        echo "The runtime is already installed in $dir (use --force to install it again).\n";
        return 0;
    }

    $expected = strtolower($o['values']['sha256'] ?? '');
    if ($expected === '') {
        $sidecar = tempnam(sys_get_temp_dir(), 'cefloom-sha');
        fetch($url . '.sha256', $sidecar, false);
        $expected = strtolower(substr(trim((string) file_get_contents($sidecar)), 0, 64));
        unlink($sidecar);
    }
    if (!preg_match('/^[0-9a-f]{64}$/', $expected)) {
        fail('no SHA-256 checksum: give --sha256=<hex> or publish <archive>.sha256 next to the archive');
    }

    $work = $dir . '.tmp-' . getmypid();
    remove_tree($work);
    if (!mkdir($work, 0755, true)) {
        fail("cannot create $work");
    }
    $archive = $work . '/runtime.tar.gz';
    echo "Downloading $url\n";
    $bytes = fetch($url, $archive, true);
    echo sprintf("  %.1f MB\n", $bytes / 1048576);

    if (!hash_equals($expected, hash_file('sha256', $archive))) {
        remove_tree($work);
        fail('the SHA-256 checksum of the archive does not match: not installed');
    }

    echo "Unpacking\n";
    $extracted = $work . '/files';
    mkdir($extracted);
    try {
        (new PharData($archive))->extractTo($extracted, null, true);
    } catch (Throwable $e) {
        remove_tree($work);
        fail('cannot unpack the archive: ' . $e->getMessage());
    }
    $manifest = json_decode((string) @file_get_contents($extracted . '/cefloom-runtime.json'), true);
    if (!is_array($manifest) || ($manifest['cef'] ?? null) !== $cef) {
        $found = is_array($manifest) ? (string) ($manifest['cef'] ?? 'unknown') : 'no manifest';
        remove_tree($work);
        fail("the archive holds CEF $found, the module needs $cef: not installed");
    }
    foreach (['cefloomsubprocess', 'libcef.so', 'libvk_swiftshader.so', 'libvulkan.so.1'] as $executable) {
        if (is_file($extracted . '/' . $executable)) {
            chmod($extracted . '/' . $executable, 0755);
        }
    }
    foreach ($manifest['files'] ?? [] as $file) {
        if (!is_file($extracted . '/' . $file)) {
            remove_tree($work);
            fail("the archive lacks $file: not installed");
        }
    }

    unlink($archive);
    if (file_exists($dir)) {
        remove_tree($dir);
    }
    if (!is_dir(dirname($dir)) && !mkdir(dirname($dir), 0755, true)) {
        remove_tree($work);
        fail('cannot create ' . dirname($dir));
    }
    if (!rename($extracted, $dir)) {
        remove_tree($work);
        fail("cannot move the runtime to $dir");
    }
    remove_tree($work);
    echo "Installed the CEF runtime in $dir\n";
    return 0;
}

$command = $argv[1] ?? '';
switch ($command) {
    case 'install':
        exit(install(options(array_slice($argv, 2))));
    case 'status':
        exit(status());
    case 'path':
        echo Cef::runtimeDirectory(), "\n";
        exit(0);
    default:
        fwrite(STDERR, "usage: cefloom-runtime install [--url=<archive> | --base-url=<release directory>] [--sha256=<hex>] [--dir=<directory>] [--force]\n"
            . "       cefloom-runtime status\n       cefloom-runtime path\n");
        exit($command === '' || $command === 'help' ? 0 : 2);
}
